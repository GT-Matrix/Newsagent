{
  "steps": {
    "rss": {
      "enabled": true,
      "limit_per_feed": 20
    },
    "newsnow": {
      "enabled": true,
      "columns": [
        "tech",
        "finance"
      ],
      "include_all": false,
      "limit_per_source": 50,
      "retries": 2,
      "retry_delay": 1.0
    },
    "site_lists": {
      "enabled": true,
      "sites": [],
      "limit_per_site": 10
    }
  },
  "paper_attach": {
    "enabled": true,
    "source": "huggingface",
    "limit": 40,
    "query": "cat:cs.AI OR cat:cs.CL OR cat:cs.LG OR cat:cs.CV OR cat:stat.ML OR all:\"large language model\" OR all:\"LLM\" OR all:\"agent\"",
    "sort_by": "submittedDate",
    "sort_order": "descending",
    "max_summary_chars": 700
  },
  "classification": {
    "enabled": true,
    "batch_size": 40,
    "batch_concurrency": 20,
    "event_candidate_count": 5,
    "merge_candidate_count": 5,
    "time_window_hours": 72,
    "suspect_mode": "discard"
  }
}
